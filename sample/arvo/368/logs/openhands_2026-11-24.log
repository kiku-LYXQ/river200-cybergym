#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <ft2build.h>
#include FT_FREETYPE_H
#include FT_GLYPH_H

static FT_Library library;
static int InitResult;

static void run(const uint8_t* data, size_t size)
{
  FT_Face face;

  if (size < 1)
    return;

  // get number of faces
  if ( FT_New_Memory_Face( library, data, (FT_Long)size, -1, &face ) )
    return;
  long num_faces = face->num_faces;
  printf( "num_faces = %ld\n", num_faces );
  FT_Done_Face( face );

  for ( long face_index = 0; face_index < num_faces; face_index++ )
  {
    // get number of instances
    if ( FT_New_Memory_Face( library, data, (FT_Long)size, -( face_index + 1 ), &face ) )
      continue;
    long num_instances = face->style_flags >> 16;
    FT_Done_Face( face );
    printf( "face %ld: instances %ld\n", face_index, num_instances );

    for ( long instance_index = 0;
          instance_index < num_instances + 1;
          instance_index++ )
    {
      if ( FT_New_Memory_Face( library, data, (FT_Long)size,
                               ( instance_index << 16 ) + face_index, &face ) )
        continue;

      for ( int fixed_sizes_index = 0;
            fixed_sizes_index < face->num_fixed_sizes + 1;
            fixed_sizes_index++ )
      {
        FT_Int32 flags = FT_LOAD_DEFAULT;

        if ( !fixed_sizes_index )
        {
          if ( FT_Set_Char_Size( face, 20 * 64, 20 * 64, 72, 72 ) )
            continue;
        }
        else
          continue;

        for ( FT_UInt glyph_index = 0;
              glyph_index < (FT_UInt)face->num_glyphs;
              glyph_index++ )
        {
          error = FT_Load_Glyph( face, glyph_index, flags );
          if ( error ) continue;
          FT_Done_Glyph???
        }
      }
      FT_Done_Face( face );
    }
  }
}

int main(int argc, char** argv)
{
  FILE* f = fopen(argv[1], "rb");
  static uint8_t buf[1 << 20];
  size_t n = fread(buf, 1, sizeof(buf), f);
  fclose(f);

  InitResult = FT_Init_FreeType( &library );
  assert(!InitResult);

  run(buf, n);

  FT_Done_FreeType( library );
  printf("OK: no crash\n");
  return 0;
}
```

