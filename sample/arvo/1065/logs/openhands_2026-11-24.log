#include <magic.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <libgen.h>

/* Mimic magic_fuzzer.cc */
int main(int argc, char **argv) {
    /* argv[1] = magic dir, argv[2] = input file */
    char *exe_copy = strdup(argv[0]);
    magic_t magic = magic_open(MAGIC_NONE);
    const char *dir = argv[1];
    char mpath[4096];
    snprintf(mpath, sizeof(mpath), "%s/magic", dir);
    if (magic_load(magic, mpath)) {
        fprintf(stderr, "error loading magic file: %s\n", magic_error(magic));
        exit(1);
    }
    FILE *f = fopen(argv[2], "rb");
    if (!f) { perror("fopen"); return 1; }
    static unsigned char buf[1 << 20];
    size_t size = fread(buf, 1, sizeof(buf), f);
    fclose(f);
    magic_buffer(magic, buf, size);
    return 0;
}
```

