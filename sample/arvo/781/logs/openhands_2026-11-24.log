#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define PCRE2_ANCHORED 0x00000001u
#define PCRE2_NO_UTF_CHECK 0x00002000u
#define PCRE2_ALLOW_EMPTY_CLASS 0x00000001u
#define PCRE2_ALT_BSUX 0x00000002u
#define PCRE2_ALT_CIRCUMFLEX 0x00000004u
#define PCRE2_ALT_VERBNAMES 0x00000008u
#define PCRE2_AUTO_CALLOUT 0x00000010u
#define PCRE2_CASELESS 0x00000020u
#define PCRE2_DOLLAR_ENDONLY 0x00000040u
#define PCRE2_DOTALL 0x00000080u
#define PCRE2_DUPNAMES 0x00000080u
#define PCRE2_EXTENDED 0x00000200u
#define PCRE2_FIRSTLINE 0x00000400u
#define PCRE2_MATCH_UNSET_BACKREF 0x00004000u
#define PCRE2_MULTILINE 0x00000800u
#define PCRE2_NEVER_BACKSLASH_C 0x00040000u
#define PCRE2_NO_AUTO_CAPTURE 0x00010000u
#define PCRE2_NO_AUTO_POSSESS 0x00020000u
#define PCRE2_NO_DOTSTAR_ANCHOR 0x00010000u
#define PCRE2_NO_START_OPTIMIZE 0x00080000u
#define PCRE2_UCP 0x00800000u
#define PCRE2_UNGREEDY 0x01000000u
#define PCRE2_USE_OFFSET_LIMIT 0x02000000u
#define PCRE2_UTF 0x04000000u

#define ALLOWED_COMPILE_OPTIONS \
  (PCRE2_ANCHORED|PCRE2_ALLOW_EMPTY_CLASS|PCRE2_ALT_BSUX|PCRE2_ALT_CIRCUMFLEX| \
   PCRE2_ALT_VERBNAMES|PCRE2_AUTO_CALLOUT|PCRE2_CASELESS|PCRE2_DOLLAR_ENDONLY| \
   PCRE2_DOTALL|PCRE2_DUPNAMES|PCRE2_EXTENDED|PCRE2_FIRSTLINE| \
   PCRE2_MATCH_UNSET_BACKREF|PCRE2_MULTILINE|PCRE2_NEVER_BACKSLASH_C| \
   PCRE2_NO_AUTO_CAPTURE| \
   PCRE2_NO_AUTO_POSSESS|PCRE2_NO_DOTSTAR_ANCHOR|PCRE2_NO_START_OPTIMIZE| \
   PCRE2_UCP|PCRE2_UNGREEDY|PCRE2_USE_OFFSET_LIMIT| \
   PCRE2_UTF)

int main(void)
{
  for (int seed = 0; seed < 256; seed++)
    {
    srand((unsigned int)seed);
    int r1 = rand();
    int r2 = rand();
    uint32_t opts = ((((uint32_t)r1 << 16) | ((uint32_t)r2 & 0xffff)) & ALLOWED_COMPILE_OPTIONS);
    printf("%3d %-4s %08x%s%s%s\n", seed,
      (seed >= 32 && seed < 127) ? (char[]){(char)seed,0} : "hex",
      opts,
      (opts & PCRE2_ANCHORED) ? " ANCHORED" : "",
      (opts & PCRE2_AUTO_CALLOUT) ? " AUTOCALLOUT" : "",
      (opts & PCRE2_EXTENDED) ? " EXTENDED" : "");
    }
  return 0;
}
```

