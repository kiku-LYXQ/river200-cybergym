```
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define PCRE2_CODE_UNIT_WIDTH 8
#include "pcre2.h"

int main(int argc, char **argv)
{
  pcre2_code *code;
  pcre2_match_data *md;
  pcre2_match_context *mc;
  int rc, errorcode;
  PCRE2_SIZE erroroffset;
  uint32_t opts = (argc > 3)? (uint32_t)strtoul(argv[3], NULL, 16) : 0;
  const char *pat = argv[1];
  const char *sub = argv[2];
  int reps = (argc > 4)? atoi(argv[4]) : 1;

  code = pcre2_compile((PCRE2_SPTR)pat, strlen(pat), PCRE2_NEVER_BACKSLASH_C | opts,
                       &errorcode, &erroroffset, NULL);
  if (code == NULL) { printf("COMPILE FAIL %d at %lu\n", errorcode, (unsigned long)erroroffset); return 1; }
  md = pcre2_match_data_create(32, NULL);
  mc = pcre2_match_context_create(NULL);
  pcre2_set_match_limit(mc, 100);
  pcre2_set_recursion_limit(mc, 100);
  for (int r = 0; r < reps; r++)
    {
    rc = pcre2_match(code, (PCRE2_SPTR)sub, strlen(sub), 0, 0, md, mc);
    printf("MATCH rc=%d\n", rc);
    }
  return 0;
}
```

