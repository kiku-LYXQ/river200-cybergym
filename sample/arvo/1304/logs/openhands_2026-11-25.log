                gnutls_assert();
                result = _gnutls_asn2err(result);
                goto cleanup;
        }

        result =
            _gnutls_x509_der_encode_and_copy(c2, "", pkcs12,
                                             "authSafe.content", 1);
        if (result < 0) {
                gnutls_assert();
                goto cleanup;
        }
        asn1_delete_structure(&c2);

        return 0;

      cleanup:
        asn1_delete_structure(&c2);
        return result;

}

