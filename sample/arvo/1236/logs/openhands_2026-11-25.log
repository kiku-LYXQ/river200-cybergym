        return (const guint8 *)self->oid + DOFObjectID_GetClassSize(self) + 1;          /* 1: length of length byte. */

    return NULL;
}

static guint32 DOFObjectID_GetIDClass(const DOFObjectID self)
{
    guint32 size = 4;

