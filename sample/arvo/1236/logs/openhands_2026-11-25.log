                if (!(*pNextAttribute & 0x80))
                    break;                                      /* Fail: no more Attributes */
                pNextAttribute += (2 + *((const guint8 *)pNextAttribute + 1));
            }
        }
    }

    return retAttributeDescriptor;
}

